{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "allowJs": false,
    "noEmit": true,
    "incremental": true
  },
  "include": ["next-env.d.ts", "src", "scripts", "test", ".next/types/**/*.ts", "next.config.ts"],
  "exclude": ["node_modules"]
}
