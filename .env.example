# Gabriel Trade Copier configuration — copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  pnpm keys:generate

# --- Domain / URLs ---
GTC_DOMAIN=copier.example.com
BETTER_AUTH_URL=https://copier.example.com
PUBLIC_BRIDGE_URL=https://copier.example.com

# --- Owner (single user; created with the owner CLI, password is prompted) ---
OWNER_EMAIL=owner@example.com

# --- Secrets (placeholders — replace) ---
POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=replace-with-32+-random-bytes
# Encryption key ring for stored credentials/tokens. Lives here, never in the database.
# Format keyId:base64(32 bytes)[,oldKeyId:base64]
GTC_ENCRYPTION_ACTIVE_KEY_ID=k1
GTC_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES

# --- Local development only (docker compose builds DATABASE_URL itself) ---
DATABASE_URL=postgres://gtc:change-me@localhost:5432/gtc

# --- Engine safety ---
# Live (real-money) follower execution. Keep false unless you have validated on demo.
LIVE_TRADING_ENABLED=false
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

# --- TradeLocker ---
# Optional: only needed for the official Streams API (not used yet; polling is used).
TRADELOCKER_DEVELOPER_API_KEY=
TRADELOCKER_POLL_MS=1000

# --- Match-Trader ---
MATCHTRADER_POLL_MS=1500
MATCHTRADER_REQUESTS_PER_SECOND=2
# Edit/close request bodies are not verified against the official docs; DEMO only when true.
MATCHTRADER_ENABLE_UNVERIFIED_BODIES=false
# Paths not available in the documentation we could access. Copy them from the official
# Platform API reference, relative to /mtr-api/{SYSTEM_UUID}, e.g. /some-path
MATCHTRADER_PATH_SYMBOLS=
MATCHTRADER_PATH_QUOTES=
MATCHTRADER_PATH_PARTIAL_CLOSE=
MATCHTRADER_PATH_ACTIVE_ORDERS=

# --- Simulation ---
SIM_POLL_MS=500
FOLLOWER_REFRESH_MS=5000
